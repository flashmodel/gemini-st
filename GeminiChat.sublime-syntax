%YAML 1.2
---
# http://www.sublimetext.com/docs/syntax.html
name: GeminiChat
hidden: true
scope: text.html.markdown.geminichat
version: 2

contexts:
  main:
    - match: '^(⏺\s*(?:Read|Edit|Write|read|edit|write)\s+)(\S+.*)$'
      captures:
        1: entity.name.function.geminichat
        2: variable.function.geminichat
    - match: '^(⏺\s*\S+)(.*)$'
      captures:
        1: entity.name.function.geminichat
    - match: '^(▣\s*)(\S.*)$'
      captures:
        1: variable.parameter.geminichat
        2: variable.function.geminichat
    - include: scope:text.html.markdown#markdown
